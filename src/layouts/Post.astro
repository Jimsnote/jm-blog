---
import Base from './Base.astro';
import { AUTHOR, SITE_TITLE } from '../consts';
import { formatDate } from '../utils/blog';

export interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
}
const { title, description, date, tags } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<Base title={title} description={description} canonical={canonical} type="article">
  <article>
    <h1 class="post-title">{title}</h1>
    <p class="post-meta">
      {formatDate(date)} · {AUTHOR}
    </p>
    <p class="post-tags">
      {tags.map((tag) => <a class="tag" href={`/tags/${tag}/`}>#{tag}</a>)}
    </p>
    <div class="prose">
      <slot />
    </div>
    <p style="margin-top:48px; font-size:14px; color:var(--text-muted);">
      <a href="/blog/">← 返回文章列表</a> · <a href="/rss.xml">RSS 订阅</a>
    </p>
  </article>
</Base>
