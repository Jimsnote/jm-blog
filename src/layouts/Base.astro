---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  type?: string;
}
const { title, description, canonical, type } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} canonical={canonical} type={type} />
  </head>
  <body>
    <Header />
    <main class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>
