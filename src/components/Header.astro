---
import ThemeToggle from './ThemeToggle.astro';
const nav = [
  { href: '/', label: '首页' },
  { href: '/blog/', label: '文章' },
  { href: '/tags/', label: '标签' },
  { href: '/about/', label: '关于' }
];
---
<header class="site-header">
  <div class="inner">
    <a class="brand" href="/">JM · AI 与独立开发</a>
    <nav>
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <ThemeToggle />
    </nav>
  </div>
</header>
