---
import Base from '../../layouts/Base.astro';
import { getPublishedPosts, formatDate } from '../../utils/blog';
const posts = await getPublishedPosts();
---
<Base title="文章" description="全部文章：AI 工具实测、企业应用与独立开发笔记。">
  <h1 style="font-size:26px; margin:48px 0 8px;">全部文章</h1>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a class="title" href={`/blog/${post.id}/`}>{post.data.title}</a>
        <div class="meta">{formatDate(post.data.date)}</div>
        <p style="margin:6px 0 0; color:var(--text-muted); font-size:14px;">{post.data.description}</p>
      </li>
    ))}
  </ul>
</Base>
