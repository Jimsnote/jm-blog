---
import Base from '../layouts/Base.astro';
import { getPublishedPosts, formatDate } from '../utils/blog';
const posts = (await getPublishedPosts()).slice(0, 5);
---
<Base title="首页">
  <h1 style="font-size:26px; margin:48px 0 8px;">你好，我是 JM 👋</h1>
  <p style="color:var(--text-muted);">
    SAP FICO 顾问，关注 AI 应用与独立开发。这里记录我的 AI 工具实测、企业数字化思考与踩坑记录。
  </p>
  <h2 style="margin-top:40px; font-size:20px;">最新文章</h2>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a class="title" href={`/blog/${post.id}/`}>{post.data.title}</a>
        <div class="meta">
          {formatDate(post.data.date)}
          {post.data.tags.map((tag) => <a class="tag" href={`/tags/${tag}/`}>#{tag}</a>)}
        </div>
      </li>
    ))}
  </ul>
</Base>
